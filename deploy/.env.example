MONDRIAN_IMAGE=mondrian-server:local
MONDRIAN_TARGET=combined
MONDRIAN_MEMORY=3g
MONDRIAN_CPUS=2.0
MONDRIAN_PORT=8080
# Set before enabling the https profile; DNS must point at the VM.
DOMAIN=feed.example.com
# For compose.disk.yaml only (directory owned by UID/GID 10001).
MONDRIAN_DATA_DIR=/srv/mondrian/data
# Optional; do not commit populated credentials.
MASTODON_TOKEN=
THREADS_ACCESS_TOKEN=
